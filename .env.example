# iLearn4U environment variables
# Copy to .env.local for local development. Never commit real secrets.
# Full setup walkthroughs: docs/SUPABASE_SETUP.md, docs/SQUARE_SETUP.md,
# docs/NETLIFY_DOMAIN_SETUP.md, docs/SECURITY.md

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Safe public client values — see docs/SUPABASE_SETUP.md. Set these in
# Netlify -> Site configuration -> Environment variables for production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. NEVER prefix with NEXT_PUBLIC_. Never expose to browser
# code or commit to git. Bypasses Row Level Security entirely — see
# docs/SECURITY.md.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Square) -------------------------------------------------------
# See docs/SQUARE_SETUP.md for how to get each of these from the Square
# Developer Dashboard. Start with Sandbox values; switch to Production only
# once you're ready to take real payments.
SQUARE_ACCESS_TOKEN=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
# Location ID isn't sensitive (Square's own docs show it in client-side code)
# so it's set twice: once for server-side API calls, once for the browser SDK.
SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Set BOTH of these to the same value — the server needs the bare one, the
# browser-side card form needs the NEXT_PUBLIC_ one (see SquareCardForm.tsx).
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

# --- Analytics ---------------------------------------------------------------
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX). Leave blank to
# disable analytics entirely (no script loads in dev unless this is set).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Email / notifications ---------------------------------------------------
EMAIL_FROM_ADDRESS=notifications@ilearn4u.com.au
EMAIL_PROVIDER_API_KEY=
